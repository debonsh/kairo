# === EXCHANGE API KEYS ===
# Create at: https://testnet.bybit.com (for paper) or https://www.bybit.com (for live)
# TRADE-ONLY permissions, NO WITHDRAWAL. IP-whitelisted.
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here

# IP address(es) allowed to use these keys (comma-separated)
API_IP_WHITELIST=

# === TELEGRAM ===
# Create bot: message @BotFather on Telegram, send /newbot
# Get chat ID: message @userinfobot on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_user_id

# === LLM PROVIDERS ===
# Ollama (local, free, RTX 3070)
OLLAMA_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://localhost:11434

# CommandCode Go (your subscription)
COMMANDCODE_API_KEY=your_commandcode_api_key
COMMANDCODE_BASE_URL=https://api.commandcode.ai/v1
COMMANDCODE_MODEL=deepseek-v4-pro

# DeepSeek (cloud, cheap, backup)
DEEPSEEK_API_KEY=your_deepseek_api_key

# OpenAI (cloud, optional)
OPENAI_API_KEY=your_openai_api_key

# Groq (cloud, fast, free tier available)
GROQ_API_KEY=your_groq_api_key

# === LLM ROUTING ===
LLM_REALTIME_PROVIDER=ollama
LLM_RESEARCH_PROVIDER=commandcode
