{
  "$schema": "./tokens.schema.json",
  "version": "2.0.0",
  "source": "KAIRO-DESIGN-RFC-001 §4.2 / §4.3 / §5.2 / §6.2 / §14.2 / §20 (canonical, replaces all prior values)",
  "primitives": {
    "kairo-void": "#08080B",
    "kairo-charcoal": "#0B0F14",
    "kairo-steel": "#12141B",
    "kairo-slate": "#1E232B",
    "kairo-hairline": "#262B34",
    "kairo-mist": "#E6E6E6",
    "kairo-silver": "#9AA3B2",
    "kairo-mute": "#5C6470",
    "kairo-lime": "#39FF14",
    "kairo-cyan": "#00E5FF",
    "kairo-violet": "#7C4DFF",
    "kairo-blue": "#2962FF",
    "kairo-amber": "#FFB800",
    "kairo-coral": "#FF5C7A",
    "kairo-ink": "#FFFFFF"
  },
  "semantic": {
    "surface-base": "void",
    "surface-panel": "steel",
    "surface-raised": "slate",
    "surface-inset": "charcoal",
    "border-default": "hairline",
    "border-strong": "silver",
    "text-primary": "mist",
    "text-secondary": "silver",
    "text-tertiary": "mute",
    "text-inverse": "void",
    "status-live": "lime",
    "status-up": "lime",
    "status-down": "coral",
    "status-warn": "amber",
    "status-danger": "coral",
    "status-info": "cyan",
    "signal-primary": "cyan",
    "signal-secondary": "blue",
    "ai-primary": "violet",
    "ai-dim": "violet",
    "action-primary": "cyan",
    "action-hover": "lime",
    "focus-ring": "cyan"
  },
  "spacing": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px",
    "space-8": "64px"
  },
  "type": {
    "text-2xs": { "size": "10px", "lineHeight": "14px", "face": "mono" },
    "text-xs": { "size": "11px", "lineHeight": "16px", "face": "mono" },
    "text-sm": { "size": "12px", "lineHeight": "18px", "face": "mono" },
    "text-base": { "size": "13px", "lineHeight": "20px", "face": "ui" },
    "text-md": { "size": "14px", "lineHeight": "22px", "face": "mono" },
    "text-lg": { "size": "18px", "lineHeight": "26px", "face": "mono" },
    "text-xl": { "size": "24px", "lineHeight": "32px", "face": "mono" },
    "text-2xl": { "size": "36px", "lineHeight": "44px", "face": "mono" },
    "text-display": { "size": "48px", "lineHeight": "45.6px", "face": "dot" }
  },
  "motion": {
    "dur-instant": "0ms",
    "dur-fast": "120ms",
    "dur-base": "200ms",
    "dur-slow": "300ms",
    "ease-standard": "cubic-bezier(0.25, 0.1, 0.25, 1)"
  },
  "radius": {
    "radius-sm": "2px",
    "radius-md": "4px",
    "radius-lg": "6px"
  },
  "shadow": {
    "shadow-popover": "0 8px 24px rgba(0, 0, 0, 0.5)"
  },
  "dataGradient": ["void", "lime", "cyan", "violet", "amber"]
}
